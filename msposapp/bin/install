#!/usr/bin/bash

HOST_USER=`whoami`

#verify root
[ "$HOST_USER" != "root" ] && echo "You must be root or in sudoers to run $0." && exit 1

#Environment Name 
[ ! -f ../../.envtype ] && echo -n "Env Name: " && read ENVTYPE && echo "$ENVTYPE" >../../.envtype

#Shopcode
[ -f .shopcode ] && SHOPCODE="`cat .shopcode`"
[ "$SHOPCODE" == "" ] && echo -n "Shopcode: " && read SHOPCODE && echo "$SHOPCODE" >.shopcode

#OS Version
[ ! -f .$SHOPCODE.osversion ] && echo -n "OS Version - (rhel8, centos7, rocky9, rhel9, rhel10): " && read OSVERSION && echo "$OSVERSION" > .$SHOPCODE.osversion
OSVERSION="`cat .$SHOPCODE.osversion`"

# create base image
echo -n "Create base image? y/n: "
read answer
[ "$answer" == "n" ] && echo "Done." && exit 0
#podman rmi $(podman images -a -q) -f 2>/dev/null
./create-image
 
echo "Done!"

exit 0
