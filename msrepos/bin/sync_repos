#!/bin/bash

#left off here.......run for all versions of os..........
#
OS=rhel9
#
POSTYPE=rti
[ "$POSTYPE" == "rti" ] && VER="16" && POSDIR="usr2"
SHOPCODE="repo"
[ -f .$SHOPCODE.osversion ] && OS="`cat .$SHOPCODE.osversion`"
[ "`podman image ls | grep $OS`" == "" ] && echo "No image available. Build image first." && exit 0

#get nic name
NETDEV=$(ip route get 8.8.8.8 | awk -- '{printf $5}')

#start container
CONTAINER=`podman run -d -it -h $OS-repo.myk.sh --name=$OS-repo.myk.sh --rm --privileged -v "/var/www/html:/var/www/html" -v /sys/fs/cgroup:/sys/fs/cgroup:ro -w="/var/www/html" -i ${OS}-rti /usr/sbin/init`

#podman exec $CONTAINER rm -f /etc/yum.repos.d/*
#podman exec $CONTAINER sed -i s/gpgcheck\ =\ 1/gpgcheck\ =\ 0/g /etc/yum.repos.d/*
#podman exec $CONTAINER sed -i s/gpgcheck:\ 1/gpgcheck:\ 0/g /etc/yum.repos.d/*

#prepare local net nic for container
./bin/pipework $NETDEV -i eth1 $CONTAINER dhclient
podman exec $CONTAINER sed -i /search/d /etc/resolv.conf

#install gpg key
podman exec $CONTAINER wget http://rhel9repo.centralus.cloudapp.azure.com/rhel-9-for-x86_64-baseos/RPM-GPG-KEY-redhat-release -O /tmp/RPM-GPG-KEY-redhat-release
podman exec $CONTAINER rpmdb --rebuilddb
podman exec $CONTAINER rpm --import /tmp/RPM-GPG-KEY-redhat-release

#subscription manager register
podman exec $CONTAINER subscription-manager register --activationkey=TelefloraPOS --org=4508688

#install package with reposync
podman exec $CONTAINER yum -y install yum-utils

#sync repos
[ "$OS" == "rhel8" ] && podman exec $CONTAINER reposync -p /var/www/html --download-metadata --repo=rhel-8-for-x86_64-baseos-rpms
[ "$OS" == "rhel8" ] && podman exec $CONTAINER reposync -p /var/www/html --download-metadata --repo=rhel-8-for-x86_64-appstream-rpms

[ "$OS" == "rhel9" ] && podman exec $CONTAINER reposync -p /var/www/html --download-metadata --repo=rhel-9-for-x86_64-baseos-rpms
[ "$OS" == "rhel9" ] && podman exec $CONTAINER reposync -p /var/www/html --download-metadata --repo=rhel-9-for-x86_64-appstream-rpms

#shutdown container
#podman container rm -f $CONTAINER

exit $?
